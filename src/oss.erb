---
layout: page
title: OSS
---

<div class="grid gap-4 sm:grid-cols-2">
  <% site.data.oss.each do |repo| %>
    <a href="<%= repo.url %>" target="_blank" rel="noopener noreferrer" class="card block overflow-hidden p-0 no-underline">
      <img src="https://opengraph.githubassets.com/1/<%= repo.full_name %>" alt="<%= repo.full_name %>" class="h-40 w-full object-cover" loading="lazy" decoding="async" />
      <div class="p-4">
        <div class="flex items-start justify-between gap-2">
          <h2 class="min-w-0 flex-1 break-words font-semibold text-gray-900 dark:text-gray-100"><%= repo.full_name %></h2>
          <span class="flex flex-none items-center gap-1 text-sm text-gray-500 dark:text-gray-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
            </svg>
            <%= repo.stars %>
          </span>
        </div>
        <% if repo.description %>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-300"><%= repo.description %></p>
        <% end %>
        <% if repo.language %>
          <p class="mt-2 text-xs uppercase tracking-wide text-gray-400"><%= repo.language %></p>
        <% end %>
      </div>
    </a>
  <% end %>
</div>
