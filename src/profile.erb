---
layout: page
title: Profile
---

<div class="grid gap-8 md:grid-cols-[20rem_1fr]">
  <div>
    <img src="<%= relative_url site.data.profile.image %>" alt="<%= site.data.profile.name_en %>" class="mx-auto max-h-96 max-w-xs rounded shadow md:mx-0" />
  </div>
  <div>
    <h2 class="mb-4 border-b-2 border-gray-200 pb-2 text-3xl font-bold dark:border-gray-700">
      <%= site.data.profile.name_ja %>
      <span class="text-lg font-normal text-gray-500 dark:text-gray-400"><%= site.data.profile.name_en %></span>
    </h2>

    <div class="mb-6 flex items-center gap-4 text-gray-900 dark:text-gray-100">
      <a href="<%= site.data.profile.social.github %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
      </a>
      <a href="<%= site.data.profile.social.x %>" target="_blank" rel="noopener noreferrer" aria-label="X" class="hover:opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
          <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
        </svg>
      </a>
      <a href="<%= site.data.profile.social.facebook %>" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="hover:opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
          <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647" />
        </svg>
      </a>
      <a href="<%= site.data.profile.social.bluesky %>" target="_blank" rel="noopener noreferrer" aria-label="Bluesky" class="hover:opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
          <path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.039 0 4.615 0 3.883 0 .213 3.217 1.366 5.202 2.857" />
        </svg>
      </a>
      <a href="<%= site.data.profile.social.mixi2 %>" target="_blank" rel="noopener noreferrer" aria-label="mixi2" class="hover:opacity-70">
        <img src="<%= relative_url '/images/icons/mixi2.png' %>" alt="mixi2" class="h-6 w-6 rounded" />
      </a>
    </div>

    <p class="mb-6 whitespace-pre-line"><%= site.data.profile.introduction %></p>

    <table class="w-full text-left">
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
        <tr><th class="w-32 py-2 font-medium">居住地</th><td><%= site.data.profile.residence %></td></tr>
        <tr><th class="w-32 py-2 font-medium">出身地</th><td><%= site.data.profile.birthplace %></td></tr>
        <tr><th class="w-32 py-2 font-medium">趣味</th><td><%= site.data.profile.hobby %></td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-10 grid gap-8 md:grid-cols-[20rem_1fr]">
  <div class="hidden md:block"></div>
  <div>
    <h3 class="mb-4 text-xl font-semibold">History</h3>
    <ul class="space-y-4 border-l-2 border-gray-200 pl-4 dark:border-gray-700">
      <% site.data.profile.history.each do |item| %>
        <li>
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= item.date_label %></p>
          <p class="text-gray-800 dark:text-gray-200">
            <%= item.text %>
            <% if item.link %>
              <a href="<%= item.link %>" target="_blank" rel="noopener noreferrer" aria-label="関連リンク" class="ml-1 inline-block align-middle text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="inline h-4 w-4" fill="currentColor">
                  <path d="M12.232 4.232a2.5 2.5 0 0 1 3.536 3.536l-1.225 1.224a.75.75 0 0 0 1.061 1.06l1.224-1.224a4 4 0 0 0-5.656-5.656l-3 3a4 4 0 0 0 .225 5.865.75.75 0 0 0 .977-1.138 2.5 2.5 0 0 1-.142-3.667l3-3Z" />
                  <path d="M11.603 7.963a.75.75 0 0 0-.977 1.138 2.5 2.5 0 0 1 .142 3.667l-3 3a2.5 2.5 0 0 1-3.536-3.536l1.225-1.224a.75.75 0 0 0-1.061-1.06l-1.224 1.224a4 4 0 1 0 5.656 5.656l3-3a4 4 0 0 0-.225-5.865Z" />
                </svg>
              </a>
            <% end %>
          </p>
        </li>
      <% end %>
    </ul>
  </div>
</div>
