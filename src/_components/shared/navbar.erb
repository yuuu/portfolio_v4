<header class="sticky top-0 z-50 bg-gray-800">
  <div class="container-page flex h-16 items-center justify-between">
    <a href="<%= relative_url '/' %>" class="flex items-center gap-2 text-lg font-semibold text-white no-underline hover:text-white hover:no-underline">
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white">
        <img src="<%= relative_url '/images/logo.png' %>" alt="yuuu's portfolio" class="h-8 w-8 rounded-full object-cover" />
      </span>
      yuuu's portfolio
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm font-medium">
        <% @metadata.nav.each do |item| %>
          <li>
            <a
              href="<%= relative_url item.path %>"
              class="rounded-md px-3 py-2 text-white no-underline hover:bg-gray-700 hover:text-white <%= 'bg-gray-700' if @resource.relative_url.start_with?(item.path) %>"
            ><%= item.title %></a>
          </li>
        <% end %>
      </ul>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center p-2 text-gray-200 [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <ul class="absolute right-0 top-full w-48 space-y-1 rounded-b-lg bg-gray-800 px-4 py-3 shadow-lg">
        <% @metadata.nav.each do |item| %>
          <li>
            <a
              href="<%= relative_url item.path %>"
              class="block rounded-md px-3 py-2 text-white no-underline hover:bg-gray-700 hover:text-white <%= 'bg-gray-700' if @resource.relative_url.start_with?(item.path) %>"
            ><%= item.title %></a>
          </li>
        <% end %>
      </ul>
    </details>
  </div>
</header>
