---
layout: page
title: Books
---

<div class="space-y-8">
  <% site.data.books.each do |book| %>
    <div class="flex flex-col gap-6 md:flex-row md:items-start">
      <a href="<%= book.link %>" target="_blank" rel="noopener noreferrer" class="md:w-64 md:flex-none">
        <img src="<%= relative_url book.image %>" alt="<%= book.title %>" class="w-full rounded shadow" />
      </a>
      <div>
        <a href="<%= book.link %>" target="_blank" rel="noopener noreferrer" class="no-underline">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100"><%= book.title %></h2>
        </a>
        <p class="mt-2 text-gray-600 dark:text-gray-300"><%= book.description %></p>
      </div>
    </div>
  <% end %>
</div>
